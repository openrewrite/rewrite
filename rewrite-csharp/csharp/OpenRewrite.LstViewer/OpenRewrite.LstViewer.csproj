<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lstview</AssemblyName>
    <RootNamespace>OpenRewrite.LstViewer</RootNamespace>

    <!-- Developer utility: not shipped in any package and not embedded in the mod jar. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <OpenRewriteSdkSourcePath Condition="'$(OpenRewriteSdkSourcePath)' == ''">../OpenRewrite/OpenRewrite.csproj</OpenRewriteSdkSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(OpenRewriteSdkSourcePath)" />
  </ItemGroup>

</Project>
