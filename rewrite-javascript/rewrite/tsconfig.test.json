{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2016",
    // nodenext lets the CommonJS test files import the java-rpc fixture, which is an ES module
    "module": "nodenext",
    "types": ["vitest/globals"],
    "paths": {
      "@openrewrite/rewrite": ["./src/index.ts"],
      "@openrewrite/rewrite/*": ["./src/*/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "fixtures/**/*",
    "vitest.config.mts"
  ]
}
