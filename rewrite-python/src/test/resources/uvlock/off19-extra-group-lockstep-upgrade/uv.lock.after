version = 1
revision = 5
requires-python = ">=3.10"

[[package]]
name = "alpha"
version = "2.0"
source = { registry = "https://index.example/simple/" }
wheels = [
    { url = "https://index.example/simple/alpha/alpha-2.0-py3-none-any.whl", hash = "sha256:322d4e7102205e93e4eebcf8dbf70b9366ca5c44aec9ac9b0d32daeaf1a0d190" },
]

[package.optional-dependencies]
c = [
    { name = "alphac" },
    { name = "alphaw", marker = "sys_platform == 'win32'" },
]

[[package]]
name = "alphac"
version = "2.0"
source = { registry = "https://index.example/simple/" }
dependencies = [
    { name = "alpha" },
]
