    { url = "https://index.example/simple/alphaw/alphaw-1.0-py3-none-any.whl", hash = "sha256:2df6a53bd8fff7d64f87bb5c3ed929a51b53694b25f27a8374511c29a283400d" },
]

[[package]]
name = "s25-extra-group-lockstep-upgrade"
version = "0.1.0"
source = { virtual = "." }
dependencies = [
    { name = "alpha", extra = ["c"] },
]

[package.metadata]
requires-dist = [{ name = "alpha", extras = ["c"], specifier = "==2.0" }]
