version = 1
requires-python = ">=3.10"
resolution-markers = [
    "python_full_version < '3.12'",
    "python_full_version >= '3.12'",
]

[[package]]
name = "colorish"
version = "1.0"
source = { registry = "https://index.example/simple/" }
wheels = [
    { url = "https://index.example/simple/colorish/colorish-1.0-py3-none-any.whl", hash = "sha256:231d137b01ecdeecbca3a2e7cf97c4f224ebb581b531ce364b261b609559aec6" },
]

[[package]]
name = "forky"
version = "1.0"
source = { registry = "https://index.example/simple/" }
resolution-markers = [
    "python_full_version < '3.12'",
]
dependencies = [
    { name = "colorish", marker = "python_full_version < '3.12' and platform_system == 'Windows'" },
]
wheels = [
    { url = "https://index.example/simple/forky/forky-1.0-py3-none-any.whl", hash = "sha256:9345f78f6426e6588651be202ab4b816f0e67ab2181e764897e5ebd20eb2bafb" },
]

[[package]]
name = "forky"
version = "2.0"
source = { registry = "https://index.example/simple/" }
resolution-markers = [
    "python_full_version >= '3.12'",
]
dependencies = [
    { name = "colorish", marker = "python_full_version >= '3.12' and platform_system == 'Windows'" },
]
wheels = [
    { url = "https://index.example/simple/forky/forky-2.0-py3-none-any.whl", hash = "sha256:8e0218976dc6a76bdcbb525723c131bf9047031629e90b311e3cf40a55969b60" },
]

[[package]]
name = "keeper"
version = "1.0"
source = { registry = "https://index.example/simple/" }
wheels = [
    { url = "https://index.example/simple/keeper/keeper-1.0-py3-none-any.whl", hash = "sha256:69b5705b9b71e898cd067240f4801725481689cec4f78cd9f2655947fac7ecc3" },
]

[[package]]
name = "s53-old-uv-fork-order"
version = "0.1.0"
source = { virtual = "." }
dependencies = [
    { name = "forky", version = "1.0", source = { registry = "https://index.example/simple/" }, marker = "python_full_version < '3.12'" },
    { name = "forky", version = "2.0", source = { registry = "https://index.example/simple/" }, marker = "python_full_version >= '3.12'" },
    { name = "keeper" },
]

[package.metadata]
requires-dist = [
    { name = "forky", marker = "python_full_version < '3.12'", specifier = "<2" },
    { name = "forky", marker = "python_full_version >= '3.12'", specifier = ">=2" },
    { name = "keeper", specifier = "==1.0" },
]
