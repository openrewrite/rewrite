wheels = [
    { url = "https://index.example/simple/delta/delta-1.0-py3-none-any.whl", hash = "sha256:6158b76431213382de2dcd929c6a5ee183ceaef44a7def3ca845ad793cb25a02" },
]

[[package]]
name = "gamma"
version = "2.0"
source = { registry = "https://index.example/simple/" }
wheels = [
    { url = "https://index.example/simple/gamma/gamma-2.0-py3-none-any.whl", hash = "sha256:89bf27daefde6a3348182317ba30e477618d186227b7d4bc2761078d0c2acda5" },
]

[package.optional-dependencies]
fast = [
    { name = "delta", marker = "sys_platform == 'win32'" },
]

[[package]]
name = "s29-extra-dnf-markers"
version = "0.1.0"
source = { virtual = "." }
dependencies = [
    { name = "gamma", extra = ["fast"] },
]

[package.metadata]
requires-dist = [{ name = "gamma", extras = ["fast"], specifier = "==2.0" }]
